# OpenAI-compatible LLM endpoint for KG extraction.
# Copy to .env and fill secrets locally. Do not commit real API keys.

LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.6-plus

# Deterministic KG extraction defaults.
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=64000
LLM_ENABLE_THINKING=false

# Short LLM call for frontend query normalization / tool planning.
QUERY_NORMALIZER_TEMPERATURE=0
QUERY_NORMALIZER_TIMEOUT_SECONDS=60
QUERY_NORMALIZER_MAX_RETRIES=1
QUERY_NORMALIZER_MAX_OUTPUT_TOKENS=4096
QUERY_NORMALIZER_ENABLE_THINKING=false

# qwen3.6-plus limits used by scripts/extract_arrangement_kg.py.
LLM_CONTEXT_LENGTH=1000000
LLM_MAX_INPUT_TOKENS=991000
LLM_RPM=30000
LLM_TPM=5000000

# Vision guardrails from Alibaba Cloud Model Studio docs for qwen3.6-plus.
LLM_VISION_MAX_IMAGES=256
LLM_VISION_MAX_BASE64_IMAGES=250
LLM_VISION_MAX_PIXELS=16000000
LLM_VISION_MAX_BASE64_CHARS=10000000

# Chunking for textbook KG extraction.
KG_MAX_CHARS_PER_CHUNK=12000
KG_MAX_IMAGES_PER_REQUEST=5

# Neo4j Desktop local database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Local Chroma evidence store.
CHROMA_PATH=data/chroma
CHROMA_TEXT_COLLECTION=guitar_text_chunks
CHROMA_VISUAL_COLLECTION=guitar_visual_chunks

# Embeddings for Chroma.
# Use EMBEDDING_PROVIDER=hash to build a local placeholder vector index without API calls.
# Switch to EMBEDDING_PROVIDER=api after filling a real embedding model.
EMBEDDING_PROVIDER=hash
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_MAX_RETRIES=2
CHROMA_HASH_EMBEDDING_DIM=384
CHROMA_BATCH_SIZE=16

# Local text embedding for backend query layer and local Chroma collections.
# Keep this path local to avoid Hugging Face network checks when VPN is off.
LOCAL_EMBEDDING_MODEL=models/embedding/qwen3-embedding-0.6b
LOCAL_EMBEDDING_DEVICE=auto
LOCAL_EMBEDDING_MAX_LENGTH=2048

# Optional local reranker for second-stage evidence ordering.
# Keep disabled until a local cross-encoder/reranker model is downloaded.
RERANK_BACKEND=none
RERANK_MODEL=models/reranker/qwen3-reranker-0.6b
RERANK_DEVICE=auto
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=1024
RERANK_WEIGHT=0.45
RERANK_INSTRUCTION=Given a guitar arrangement query, retrieve textbook passages, visual captions, or knowledge graph evidence that directly help answer the query.
RERANK_ENABLED_TYPES=text,visual_caption,kg

# DashScope multimodal embedding for visual evidence.
MULTIMODAL_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
VL_EMBEDDING_MODEL=qwen3-vl-embedding
VL_EMBEDDING_DIMENSIONS=1024
